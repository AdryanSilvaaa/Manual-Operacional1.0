PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/manual_operacional
JWT_SECRET=troque-este-segredo
FRONTEND_URL=http://localhost:5173

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=manuals

# Permite testar login/admin com dados em memoria quando o PostgreSQL local nao estiver configurado.
DEV_DEMO_MODE=false
# Configuração local do backend; copie para .env e nunca versiona segredos reais.

# Banco: conexões por instância do backend. Com várias instâncias, instâncias x DB_POOL_MAX
# precisa ficar abaixo do max_connections do PostgreSQL.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
# Use true quando o banco exigir SSL (ex.: Cloud SQL por IP público).
DB_SSL=false

# Servidor HTTP: quantos proxies/balanceadores ficam na frente do backend (Google Cloud = 1).
TRUST_PROXY_HOPS=1
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_TIMEOUT_MS=10000

# Limites de upload em MB. Se mudar, ajuste também frontend/src/constants/uploads.js.
UPLOAD_MAX_PDF_MB=20
UPLOAD_MAX_VIDEO_MB=200

# Armazenamento: s3 (Cloudflare R2 no piloto), supabase ou local. Sem STORAGE_DRIVER, usa s3 quando S3_BUCKET existe.
STORAGE_DRIVER=
S3_BUCKET=
S3_ENDPOINT=https://ID_DA_CONTA.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_URL_TTL_SECONDS=600
FILE_URL_TTL_SECONDS=14400
